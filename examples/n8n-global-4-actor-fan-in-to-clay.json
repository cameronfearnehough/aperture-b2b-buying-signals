    {
      "parameters": {
        "jsCode": "const datasetIds = [];\nfor (const item of $input.all()) {\n  const dsId = item.json?.data?.defaultDatasetId ?? item.json?.defaultDatasetId;\n  if (typeof dsId === 'string' && dsId.trim().length > 0 && !datasetIds.includes(dsId.trim())) {\n    datasetIds.push(dsId.trim());\n  }\n}\nif (datasetIds.length === 0) {\n  throw new Error('No Apify defaultDatasetId values returned from upstream regional scrapers.');\n}\nreturn [{ json: { datasetIds } }];"
      },
